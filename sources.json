  "local_filter": {
    "_comment": "Regex fragments, matched case-insensitively as whole words. A strict source keeps a story when it names an oc_places entry, or when a trusted SoCal publisher's story mentions Orange. Patch is trusted only for that bare-Orange case because the Google News location feed already ties its items to Orange, California; Patch stories from the keyword searches still need an OC place.",
    "reject_patterns": [
      "Orange,?\\s+(Texas|Tex\\.?|TX|New Jersey|N\\.?J\\.?|Connecticut|Conn\\.?|CT|Massachusetts|Mass\\.?|Virginia|Va\\.?|Vermont|Vt\\.?|Ohio|Indiana|Ind\\.?|New York|N\\.?Y\\.?|Florida|Fla\\.?|North Carolina|N\\.?C\\.?)",
      "Orange County,?\\s+(Florida|Fla\\.?|FL|New York|N\\.?Y\\.?|NY|North Carolina|N\\.?C\\.?|NC|Virginia|Va\\.?|VA|Indiana|Ind\\.?|Texas|Tex\\.?|TX|Vermont|Vt\\.?)",
